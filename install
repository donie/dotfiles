#!/usr/bin/env bash
# Apply these dotfiles with chezmoi (see docs/design.md).
# First run on a machine: asks for the machine role, then applies.
# Extra arguments go to `chezmoi apply`, e.g. `./install --dry-run --verbose`.
set -euo pipefail

BASEDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if ! command -v chezmoi >/dev/null 2>&1; then
  echo "chezmoi is not installed: brew install chezmoi" >&2
  echo "(Linux: sh -c \"\$(curl -fsLS get.chezmoi.io)\" -- -b ~/.local/bin)" >&2
  exit 1
fi

if [ ! -f "${XDG_CONFIG_HOME:-$HOME/.config}/chezmoi/chezmoi.toml" ]; then
  chezmoi init --source "${BASEDIR}"
fi

chezmoi apply "$@"
