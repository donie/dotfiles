#!/usr/bin/env bash
# Apply these dotfiles with chezmoi (see docs/design.md).
# First run on a machine: asks for the machine role, then applies.
# Later runs reuse the saved role.
# Extra arguments go to `chezmoi apply`, e.g. `./install --dry-run --verbose`.
set -euo pipefail

BASEDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if ! command -v chezmoi >/dev/null 2>&1; then
  echo "chezmoi is not installed: brew install chezmoi" >&2
  echo "(Linux: sh -c \"\$(curl -fsLS get.chezmoi.io)\" -- -b ~/.local/bin)" >&2
  exit 1
fi

# Regenerates ~/.config/chezmoi/chezmoi.toml from home/.chezmoi.toml.tmpl,
# so template changes reach this machine. Prompts only on the first run;
# saved answers are reused (promptChoiceOnce / promptStringOnce).
chezmoi init --source "${BASEDIR}"

chezmoi apply "$@"
