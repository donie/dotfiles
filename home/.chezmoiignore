# Target paths (relative to ~) that chezmoi must not manage on this machine.
# Templated by OS and role; see docs/design.md#machine-roles.

{{ if eq .chezmoi.os "darwin" }}
# Linux only: macOS uses fish.
.bashrc
{{ end }}

{{ if ne .chezmoi.os "darwin" }}
# macOS only: fish (Linux uses bash), desktop apps and personal scripts.
.config/fish
.config/ghostty
.config/kitty
.config/mpv
.config/rex
Library
_runtime
{{ end }}

{{ if eq .role "server" }}
# Coding agents run on workstations and the devbox, not on servers.
.claude
.codex
.pi
{{ end }}

{{ if ne .role "mac-personal" }}
# Personal media tooling; gallery-dl's config pulls secrets from the password
# manager, BBDown is installed by the personal mise set.
.gallery-dl.conf
.config/BBDown
{{ end }}

{{ if eq .role "server" }}
# mise dev set (runtimes, dev tools) is for workstations and the devbox.
.config/mise/conf.d/dev.toml
{{ end }}

{{ if ne .role "mac-personal" }}
.config/mise/conf.d/personal.toml
{{ end }}
