{{- if eq .chezmoi.os "darwin" -}}
{{- $repo := .chezmoi.workingTree -}}
#!/bin/sh
# Install the Homebrew packages in packages/Brewfile, plus Brewfile.personal on
# mac-personal or Brewfile.work on mac-work. Never upgrades or removes anything; `brew cu` and `brew upgrade`
# stay manual. Reruns whenever a Brewfile changes:
# Brewfile sha256: {{ include (joinPath $repo "packages/Brewfile") | sha256sum }}
{{- if eq .role "mac-personal" }}
# Brewfile.personal sha256: {{ include (joinPath $repo "packages/Brewfile.personal") | sha256sum }}
{{- else if eq .role "mac-work" }}
# Brewfile.work sha256: {{ include (joinPath $repo "packages/Brewfile.work") | sha256sum }}
{{- end }}
set -u
brew=/opt/homebrew/bin/brew
if [ ! -x "$brew" ]; then
    echo "Homebrew is not installed; see https://brew.sh, then rerun ./install" >&2
    exit 0
fi

bundle() {
    "$brew" bundle install --no-upgrade --file="$1" ||
        echo "warning: some packages in $1 failed to install (App Store sign-in?)" >&2
}

bundle {{ joinPath $repo "packages/Brewfile" | quote }}
{{- if eq .role "mac-personal" }}
bundle {{ joinPath $repo "packages/Brewfile.personal" | quote }}
{{- else if eq .role "mac-work" }}
bundle {{ joinPath $repo "packages/Brewfile.work" | quote }}
{{- end }}
{{ end -}}
