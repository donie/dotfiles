{{- if and (eq .chezmoi.os "darwin") (hasKey . "hostname") -}}
#!/bin/sh
# Keep all three macOS machine names equal to the hostname chosen at
# `chezmoi init`. No-op when they match. macOS appends -N to LocalHostName
# (the Bonjour name) when it sees the name taken on the network, e.g. by this
# Mac itself on both Wi-Fi and Ethernet; that's accepted as a match, since
# macOS would just rename it again.
set -u
want={{ .hostname | quote }}
fix=""
for name in ComputerName LocalHostName HostName; do
    have=$(scutil --get "$name" 2>/dev/null || true)
    [ "$have" = "$want" ] && continue
    if [ "$name" = LocalHostName ] && expr "$have" : "$want-[0-9][0-9]*\$" >/dev/null; then
        continue
    fi
    fix="$fix $name"
done
[ -n "$fix" ] || exit 0

if sudo -n true 2>/dev/null || [ -t 0 ]; then
    for name in $fix; do
        sudo scutil --set "$name" "$want" && echo "set $name to $want"
    done
else
    echo "warning: hostname differs ($fix ); rerun ./install in a terminal to set it to $want" >&2
fi
{{ end -}}
