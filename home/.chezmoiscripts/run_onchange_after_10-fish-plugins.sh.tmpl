{{- if eq .chezmoi.os "darwin" -}}
#!/bin/sh
# Install the fisher plugins listed in fish_plugins. Plugin files are written
# into ~/.config/fish as regular files and are not tracked in this repo.
# Reruns whenever fish_plugins changes:
# fish_plugins sha256: {{ include "dot_config/private_fish/fish_plugins" | sha256sum }}
set -eu

if ! command -v fish >/dev/null 2>&1; then
    echo "fish is not installed; skipping fisher plugins" >&2
    exit 0
fi

fish -c '
    if not functions -q fisher
        curl -fsSL https://raw.githubusercontent.com/jorgebucaran/fisher/main/functions/fisher.fish | source
    end
    fisher update
'
{{ end -}}
