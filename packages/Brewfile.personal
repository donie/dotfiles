# Personal Mac only (role mac-personal), on top of the shared Brewfile.

# mpv and its build toolchain (bin script build-mpv)
brew "mpv"
brew "cmake"
brew "meson"
brew "pkgconf"
brew "dylibbundler"
brew "luajit-openresty"

brew "handbrake"
brew "telegram-downloader"
brew "ollama"

# Media
cask "iina"
cask "vlc"
cask "spotify"
cask "vox"
cask "handbrake-app"
cask "subler"
cask "mkvtoolnix-app"
cask "mp4tools"
cask "ff-works"
cask "upscayl"
cask "macwhisper"
cask "screenkite"

# Reading, photos
cask "calibre"
cask "powerphotos"

# Chat (telegram-desktop provides the session tdl logs in with)
cask "discord"
cask "telegram"
cask "telegram-desktop"

# Games and streaming
cask "steam"
cask "league-of-legends"
cask "moonlight"

# Network (kept off the work Mac: remote-access tools are a policy concern there)
cask "tailscale-app"

# Storage
cask "google-drive"
cask "daisydisk"
cask "balenaetcher"
cask "phoenix-slides"

