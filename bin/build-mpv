#!/usr/bin/env bash

# mpv Auto-Build Script for macOS
# Run manually to update, build, and install mpv

set -e  # Exit on any error

# ============================================================================
# Configuration
# ============================================================================
MPV_REPO_DIR="$HOME/_runtime/mpv"  # UPDATE THIS to your mpv repo location
MPV_REPO_URL="https://github.com/mpv-player/mpv.git"
ICON_FILE="$HOME/dotfiles/mpv/MPV.icns"  # UPDATE THIS to your icon file location
INSTALL_DIR="/Applications"
BUILD_STATIC=false  # Set to true if you want static build with dylibbundler

# Code signing identity used for the installed bundle.
#
# macOS keys TCC (Privacy & Security) grants to the app's code signature. With an
# ad-hoc signature the key is the binary's cdhash, which changes on every rebuild,
# so every "allow mpv to access this folder" grant is silently thrown away and the
# next Finder double-click either re-prompts or fails to open the file (mpv then
# falls back to the pseudo-gui idle screen). A stable self-signed certificate keeps
# the designated requirement constant across rebuilds, so grants survive.
#
# Run `build-mpv --create-signing-identity` once to create it.
SIGN_IDENTITY="${MPV_SIGN_IDENTITY:-mpv-local}"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# ============================================================================
# Helper Functions
# ============================================================================
log_info() {
    echo -e "${BLUE}[INFO]${NC} $1"
}

log_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1"
}

log_warning() {
    echo -e "${YELLOW}[WARNING]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

# Note: deliberately NOT `find-identity -v`. A self-signed certificate is
# reported as CSSMERR_TP_NOT_TRUSTED and excluded from the "valid identities"
# list, but codesign signs with it happily and the resulting signature passes
# `codesign --verify --strict`. Trust only matters for Gatekeeper assessment of
# quarantined downloads, which a locally built app never goes through.
has_signing_identity() {
    security find-identity -p codesigning 2>/dev/null \
        | grep -q "\"$SIGN_IDENTITY\""
}

# Create a self-signed code signing certificate in the login keychain, so the
# bundle keeps the same code signing identity across rebuilds and macOS can
# remember its Files & Folders / network volume permissions.
create_signing_identity() {
    if has_signing_identity; then
        log_info "Signing identity '$SIGN_IDENTITY' already exists, nothing to do"
        return 0
    fi

    local tmp
    tmp=$(mktemp -d)
    trap 'rm -rf "$tmp"' RETURN

    log_info "Creating self-signed code signing certificate '$SIGN_IDENTITY'..."
    openssl req -x509 -newkey rsa:2048 -nodes -days 7300 \
        -keyout "$tmp/key.pem" -out "$tmp/cert.pem" \
        -subj "/CN=$SIGN_IDENTITY" \
        -addext "basicConstraints=critical,CA:false" \
        -addext "keyUsage=critical,digitalSignature" \
        -addext "extendedKeyUsage=critical,codeSigning" 2>/dev/null

    if [ ! -s "$tmp/cert.pem" ] || [ ! -s "$tmp/key.pem" ]; then
        log_error "openssl failed to generate the certificate ($(openssl version))"
        return 1
    fi

    # macOS's Security framework cannot read OpenSSL 3's default PKCS#12 output
    # (AES-256-CBC + PBKDF2 with an HMAC-SHA256 MAC); `security import` fails
    # with "MAC verification failed during PKCS12 import". Force the legacy
    # SHA1/3DES algorithms, and use a non-empty passphrase — an empty one trips
    # the same check.
    local p12pass="mpv-local-import"
    openssl pkcs12 -export -out "$tmp/identity.p12" \
        -inkey "$tmp/key.pem" -in "$tmp/cert.pem" \
        -name "$SIGN_IDENTITY" \
        -keypbe PBE-SHA1-3DES -certpbe PBE-SHA1-3DES -macalg sha1 \
        -passout "pass:$p12pass" 2>/dev/null

    if [ ! -s "$tmp/identity.p12" ]; then
        log_error "openssl failed to export the PKCS#12 bundle"
        return 1
    fi

    log_info "Importing into the login keychain..."
    security import "$tmp/identity.p12" \
        -k "$HOME/Library/Keychains/login.keychain-db" \
        -P "$p12pass" -A -T /usr/bin/codesign || return 1

    if has_signing_identity; then
        log_success "Signing identity '$SIGN_IDENTITY' created"
        log_info "Keychain Access shows it as untrusted; that is expected and harmless."
    else
        log_error "Certificate was imported but codesign cannot find it"
        return 1
    fi
}

# ============================================================================
# Argument Handling
# ============================================================================
case "${1:-}" in
    --create-signing-identity)
        if create_signing_identity; then exit 0; else exit 1; fi
        ;;
    -h|--help)
        echo "Usage: build-mpv [--create-signing-identity]"
        echo
        echo "  (no args)                   update, build, bundle and install mpv"
        echo "  --create-signing-identity   create the '$SIGN_IDENTITY' self-signed"
        echo "                              certificate on its own. Not normally"
        echo "                              needed: a plain 'build-mpv' creates it"
        echo "                              automatically when it is missing."
        echo
        echo "Environment:"
        echo "  MPV_SIGN_IDENTITY           override the signing identity name"
        exit 0
        ;;
    "") ;;
    *)
        log_error "Unknown argument: $1 (try --help)"
        exit 1
        ;;
esac

# ============================================================================
# Pre-flight Checks
# ============================================================================
log_info "Starting mpv build process..."

# Check if git is installed
if ! command -v git &> /dev/null; then
    log_error "git is not installed. Please install it first:"
    log_error "  xcode-select --install"
    exit 1
fi

# Check if icon file exists (only warn, not critical)
if [ ! -f "$ICON_FILE" ]; then
    log_warning "Icon file not found at: $ICON_FILE"
    log_warning "Will skip icon setting step"
    SKIP_ICON=true
else
    SKIP_ICON=false
fi

# Ensure a stable signing identity exists. It lives in the login keychain rather
# than in this repo (a private key has no business being committed), so a freshly
# set up Mac won't have one — create it on demand. The certificate is per-machine,
# which is fine: macOS privacy grants are per-machine too and never sync.
#
# Falling back to ad-hoc still produces a working app, but macOS will forget its
# privacy permissions on every rebuild.
if has_signing_identity; then
    log_info "Signing identity found: $SIGN_IDENTITY"
    USE_ADHOC=false
elif create_signing_identity; then
    USE_ADHOC=false
else
    log_warning "Could not create the '$SIGN_IDENTITY' signing identity"
    log_warning "Falling back to ad-hoc signing; macOS will re-prompt for folder"
    log_warning "access after every rebuild"
    USE_ADHOC=true
fi

# ============================================================================
# Clone or Verify Repository
# ============================================================================
if [ ! -d "$MPV_REPO_DIR" ]; then
    log_info "mpv repository not found at: $MPV_REPO_DIR"
    log_info "Cloning mpv repository from $MPV_REPO_URL..."

    # Create parent directory if it doesn't exist
    PARENT_DIR=$(dirname "$MPV_REPO_DIR")
    mkdir -p "$PARENT_DIR"

    git clone "$MPV_REPO_URL" "$MPV_REPO_DIR"
    log_success "Repository cloned successfully"
elif [ ! -d "$MPV_REPO_DIR/.git" ]; then
    log_error "Directory exists at $MPV_REPO_DIR but is not a git repository"
    log_error "Please remove it or choose a different location"
    exit 1
else
    log_info "Repository found at: $MPV_REPO_DIR"
fi

# ============================================================================
# Install Build Dependencies
# ============================================================================
log_info "Checking build dependencies..."

# Check if Homebrew is installed
if ! command -v brew &> /dev/null; then
    log_error "Homebrew is not installed. Please install it first:"
    log_error "  /bin/bash -c \"\$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)\""
    exit 1
fi

# Ask brew what mpv declares (runtime + :build deps) and install whatever is
# missing. Deriving the list instead of hardcoding tools keeps this correct if
# upstream swaps build systems or adds dependencies.
if MPV_DECLARED_DEPS=$(HOMEBREW_NO_ENV_HINTS=1 brew deps --include-build --direct mpv); then
    log_info "mpv declares $(echo "$MPV_DECLARED_DEPS" | wc -l | tr -d ' ') dependencies (build deps included)"
else
    log_warning "Could not query mpv's declared dependencies from brew"
    MPV_DECLARED_DEPS=""
fi

# Runtime dependencies (the libraries mpv links against).
log_info "Ensuring mpv runtime dependencies are installed..."
brew install --build-from-source --only-dependencies mpv
log_success "mpv runtime dependencies satisfied"

# `brew install --only-dependencies` prunes a formula's :build dependencies
# unless brew is actually going to build it from source
# (formula_installer.rb: `dep.build? && !install_bottle_for?(...) &&
# (formula.head? || !dependent.latest_version_installed?)`). With an up-to-date
# mpv already installed that is always false, so meson/ninja/pkgconf/docutils are
# dropped and brew reports "All dependencies are satisfied" while the build
# toolchain is missing. There is no `--include-build` for `brew install` (only
# for `brew deps`/`brew uses`), so install whatever brew declared but skipped.
MISSING_DEPS=()
while IFS= read -r dep; do
    [ -n "$dep" ] || continue
    brew list "$dep" &> /dev/null || MISSING_DEPS+=("$dep")
done <<< "$MPV_DECLARED_DEPS"

if [ ${#MISSING_DEPS[@]} -gt 0 ]; then
    log_warning "dependencies brew left uninstalled: ${MISSING_DEPS[*]}"
    log_info "This will run: brew install ${MISSING_DEPS[*]}"
    log_info "This may take a while on first run..."

    # Deliberately installed by name (not --as-dependency): build-only tools are
    # leaves in the dependency graph, so brew autoremove was free to delete
    # meson between runs and break this script. Installing them on request keeps
    # the toolchain around; `brew install --as-dependency` restores the old
    # autoremovable behaviour if you prefer brew to own the lifecycle.
    brew install "${MISSING_DEPS[@]}"

    log_success "Missing dependencies installed"
else
    log_info "All declared dependencies are present"
fi

# `luajit` in that list is brew's LuaJIT 2.1 (rolling release, arm64 bottles),
# which is what mpv's Homebrew formula declares and what this build links
# against. luajit-openresty is deliberately not used: it is keg-only and
# conflicts with luajit, so pkg-config only sees it when PKG_CONFIG_PATH points
# at it. It was a workaround for the LuaJIT 2.0/2.1.0-beta3 era (broken on
# macOS, no arm64), which ended when upstream's v2.1 branch became the rolling
# release that Homebrew now ships.

# Verify the build toolchain the build steps below rely on is available
if ! command -v meson &> /dev/null; then
    log_error "meson still not found after installation attempt"
    log_error "Please run manually: brew install meson"
    exit 1
fi

log_success "All build dependencies verified"

# ============================================================================
# Update Repository
# ============================================================================
log_info "Navigating to mpv repository: $MPV_REPO_DIR"
cd "$MPV_REPO_DIR"

log_info "Checking for updates..."
git fetch origin master

LOCAL_COMMIT=$(git rev-parse HEAD)
REMOTE_COMMIT=$(git rev-parse origin/master)

if [ "$LOCAL_COMMIT" = "$REMOTE_COMMIT" ]; then
    log_info "Already up to date (commit: ${LOCAL_COMMIT:0:8})"
    read -p "No updates found. Continue building anyway? (y/N): " -n 1 -r
    echo
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        log_info "Exiting..."
        exit 0
    fi
else
    log_info "Updates found!"
    log_info "Current: ${LOCAL_COMMIT:0:8}"
    log_info "Remote:  ${REMOTE_COMMIT:0:8}"
fi

log_info "Resetting repository..."
git reset --hard
git clean --force -d -x
git pull origin master

log_success "Repository updated successfully"

# ============================================================================
# Apply Local Patches
# ============================================================================
# Local fixes for upstream bugs that mpv has not fixed yet. The reset/pull above
# wipes the working tree, so these are re-applied from scratch on every build.
#
# Each patch file carries its own header explaining why it exists, how to tell
# when upstream has fixed the underlying bug, and what to do at that point.
# Read that header before touching a patch.
#
# Two things can happen as upstream moves, and they mean different things:
#
#   - "already present upstream" (warning, build continues): upstream landed an
#     equivalent fix, so the patch is redundant and should be deleted. This is
#     detected by reverse-applying each patch first, because `git apply --3way`
#     reports an already-applied patch as a successful no-op -- without the
#     check, a dead patch would keep "succeeding" indefinitely.
#
#   - "Failed to apply" (error, build aborts): upstream reworked this code some
#     other way. Aborting is deliberate; silently building without the patch
#     would quietly reintroduce the bug it fixes. The fix is to check whether
#     the bug is actually fixed upstream and then delete or rebase the patch --
#     not to bypass this step.
#
# Set MPV_SKIP_PATCHES=1 only to bisect whether a patch itself is at fault.
PATCH_DIR="$HOME/dotfiles/mpv/patches"
if [ -n "${MPV_SKIP_PATCHES:-}" ]; then
    log_warning "MPV_SKIP_PATCHES set, building WITHOUT local patches"
    log_warning "Any bug a patch fixes is present in this build; do not install it"
    log_warning "as your daily mpv without rebuilding cleanly afterwards"
elif [ -d "$PATCH_DIR" ] && compgen -G "$PATCH_DIR/*.patch" > /dev/null; then
    for patch in "$PATCH_DIR"/*.patch; do
        log_info "Applying $(basename "$patch")..."

        # Detect a patch upstream has made redundant. `git apply --3way` treats
        # an already-applied patch as a successful no-op and exits 0, so without
        # this check an obsolete patch would keep "succeeding" forever and never
        # signal that it should be deleted. A clean reverse-apply means the
        # change is already present in the freshly pulled tree.
        if git apply --reverse --check "$patch" 2>/dev/null; then
            log_warning "$(basename "$patch") is already present upstream"
            log_warning "The bug it fixes has been fixed in mpv itself, so this patch"
            log_warning "is now redundant. Delete it:"
            log_warning "  rm $patch"
            continue
        fi

        # --3way falls back to a merge when context has shifted, so a patch
        # survives unrelated edits nearby and only fails when the code it
        # actually touches has changed. Note it also implies --index, so
        # afterwards `git diff` compares against the patched index -- use
        # `git diff HEAD` to regenerate a patch.
        if git apply --3way "$patch"; then
            log_success "Applied $(basename "$patch")"
        else
            log_error "Failed to apply $(basename "$patch")"
            log_error ""
            log_error "Upstream changed the code this patch touches. This is expected"
            log_error "eventually and is not a build system problem. Do not skip it."
            log_error ""
            log_error "Read the header of the patch file, which records why it exists,"
            log_error "how to check whether upstream fixed the bug, and what to do:"
            log_error "  $patch"
            log_error ""
            log_error "Short version: if upstream fixed it, delete the patch file. If not,"
            log_error "edit $MPV_REPO_DIR/input/*.c by hand and regenerate with"
            log_error "'git diff HEAD -- <file>', keeping the explanatory header."
            exit 1
        fi
    done
else
    log_info "No local patches to apply"
fi

# ============================================================================
# Build mpv
# ============================================================================
log_info "Setting up build with meson..."
# -Dlua=luajit: the option defaults to `auto`, which silently yields an mpv with
# no osc/scripts if no Lua is found. Being explicit makes a missing LuaJIT a hard
# configure error instead.
meson setup build --wipe -Dlua=luajit 2>/dev/null || meson setup build -Dlua=luajit

log_info "Compiling mpv (this may take a few minutes)..."
meson compile -C build

log_info "Testing built binary..."
./build/mpv --version

log_success "Binary compiled successfully"

# ============================================================================
# Create App Bundle
# ============================================================================
log_info "Creating macOS app bundle..."
./TOOLS/osxbundle.py --skip-deps build/mpv

if [ "$BUILD_STATIC" = true ]; then
    log_info "Building static bundle with dylibbundler..."
    if ! command -v dylibbundler &> /dev/null; then
        log_error "dylibbundler not found. Install with: brew install dylibbundler"
        exit 1
    fi
    dylibbundler --bundle-deps \
        --dest-dir build/mpv.app/Contents/MacOS/lib/ \
        --install-path @executable_path/lib/ \
        --fix-file build/mpv.app/Contents/MacOS/mpv

    log_info "Testing app bundle binary..."
    ./build/mpv.app/Contents/MacOS/mpv --version
fi

log_success "App bundle created successfully"

# ============================================================================
# Patch Bundle
# ============================================================================
# Everything that modifies the bundle must happen here, BEFORE the final
# codesign pass. Touching a signed bundle invalidates its signature, and an
# invalidated signature is what makes macOS forget mpv's folder permissions.
BUNDLE="build/mpv.app"
PLIST="$BUNDLE/Contents/Info.plist"

log_info "Adding privacy usage descriptions to Info.plist..."
# Without these keys macOS has no purpose string to show for TCC-protected
# locations, so opening a file from one can be denied outright instead of
# prompting. mpv then starts idle and shows the "Drop files or URLs" screen.
add_usage_string() {
    /usr/libexec/PlistBuddy -c "Delete :$1" "$PLIST" &>/dev/null || true
    /usr/libexec/PlistBuddy -c "Add :$1 string $2" "$PLIST"
}
add_usage_string NSNetworkVolumesUsageDescription   "mpv needs access to network volumes to play media stored on them."
add_usage_string NSRemovableVolumesUsageDescription "mpv needs access to removable volumes to play media stored on them."
add_usage_string NSDesktopFolderUsageDescription    "mpv needs access to your Desktop to play media stored there."
add_usage_string NSDocumentsFolderUsageDescription  "mpv needs access to your Documents folder to play media stored there."
add_usage_string NSDownloadsFolderUsageDescription  "mpv needs access to your Downloads folder to play media stored there."

if [ "$SKIP_ICON" = false ]; then
    log_info "Installing custom icon into bundle resources..."
    # Replacing icon.icns keeps the icon inside the signed payload. The old
    # `fileicon` approach wrote an Icon\r file and a com.apple.FinderInfo xattr
    # into the app AFTER signing, which permanently broke the signature.
    cp "$ICON_FILE" "$BUNDLE/Contents/Resources/icon.icns"
    # CFBundleIconName resolves against Assets.car and would win over
    # CFBundleIconFile, so drop it and let icon.icns be used.
    /usr/libexec/PlistBuddy -c "Delete :CFBundleIconName" "$PLIST" &>/dev/null || true
fi

# Strip anything that would make the signature unsealable: Finder icon files,
# stray xattrs, and the placeholder .gitkeep files the bundle template ships
# inside Contents/MacOS (codesign treats everything in there as code and chokes
# on them with "code object is not signed at all").
find "$BUNDLE" -name "Icon?" -delete 2>/dev/null || true
find "$BUNDLE" -name ".gitkeep" -delete
xattr -cr "$BUNDLE"

log_success "Bundle patched"

# ============================================================================
# Install to Applications
# ============================================================================
log_info "Installing to $INSTALL_DIR..."

if [ -d "$INSTALL_DIR/mpv.app" ]; then
    log_warning "Existing mpv.app found, removing..."
    rm -rf "$INSTALL_DIR/mpv.app"
fi

cp -R build/mpv.app "$INSTALL_DIR/"
log_success "mpv.app installed to $INSTALL_DIR"

# ============================================================================
# Code Sign
# ============================================================================
# This must be the last step that touches the bundle. A bundle that fails
# `codesign --verify` has no stable identity, so macOS refuses to persist its
# TCC grants and Finder double-clicks intermittently land on the idle screen.
INSTALLED_APP="$INSTALL_DIR/mpv.app"

xattr -cr "$INSTALLED_APP"

if [ "$USE_ADHOC" = true ]; then
    log_info "Code signing (ad-hoc)..."
    CODESIGN_ID="-"
else
    log_info "Code signing with identity '$SIGN_IDENTITY'..."
    CODESIGN_ID="$SIGN_IDENTITY"
fi

# Nested code (bundled dylibs from a static build) must be signed before the
# bundle that seals it. Signing the bundle itself covers Contents/MacOS/mpv, so
# don't sign the main executable separately.
find "$INSTALLED_APP/Contents/MacOS" "$INSTALLED_APP/Contents/Frameworks" \
    -type f \( -name "*.dylib" -o -name "*.so" \) -print0 2>/dev/null \
    | xargs -0 codesign --force --timestamp=none -s "$CODESIGN_ID" 2>/dev/null || true

codesign --force --timestamp=none -s "$CODESIGN_ID" "$INSTALLED_APP"

log_info "Verifying signature..."
if codesign --verify --strict "$INSTALLED_APP" 2>&1; then
    log_success "Signature is valid"
else
    log_error "Signature verification FAILED"
    log_error "macOS will not remember mpv's folder permissions in this state"
    exit 1
fi

# ============================================================================
# Register with LaunchServices
# ============================================================================
# Picks up the new Info.plist (document types, usage strings, icon) without
# needing a Finder restart or a logout.
log_info "Registering app with LaunchServices..."
/System/Library/Frameworks/CoreServices.framework/Versions/A/Frameworks/LaunchServices.framework/Versions/A/Support/lsregister \
    -f "$INSTALLED_APP"
log_success "App registered"

# ============================================================================
# Final Summary
# ============================================================================
echo ""
log_success "============================================"
log_success "mpv build and installation complete!"
log_success "============================================"
log_info "Version: $(./build/mpv --version | head -n 1)"
log_info "Location: $INSTALL_DIR/mpv.app"
log_info "Build directory: $MPV_REPO_DIR/build"
echo ""
log_info "You can now launch mpv from Applications or run:"
log_info "  open -a mpv"
echo ""

if [ "$USE_ADHOC" = true ]; then
    log_warning "Signed ad-hoc: macOS will forget mpv's folder permissions on the next rebuild."
    log_warning "See the earlier warnings for why the signing identity could not be created."
    echo ""
fi
